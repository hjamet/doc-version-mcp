      },
      "artifact_name": {
        "default": "",
        "type": "string"
      },
      "brain_dir": {
        "default": "",
        "type": "string"
      },
      "content": {
        "default": "",
        "type": "string"
      },
      "diff_explanation": {
        "default": "",
